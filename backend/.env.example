# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Google Gemini API — used for natural language intent parsing
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test Credentials (use rzp_test_* keys for development)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay publishable key — safe to expose to browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay webhook secret — set in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# PostgreSQL / Supabase connection string (leave unset to use SQLite locally)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Authentication secrets — generate with: openssl rand -hex 32
ADMIN_API_KEY=your_secure_admin_api_key
AGENT_API_KEY=your_secure_agent_api_key
JWT_SECRET=your_session_jwt_secret_min_32_chars

# Vercel KV / Upstash Redis — for distributed token bucket on Vercel serverless
# These are injected automatically when you add a Vercel KV store to your project.
# KV_REST_API_URL=https://your-upstash-url.upstash.io
# KV_REST_API_TOKEN=your_upstash_token

# Alternative: direct Upstash env var names
# UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Alternative: plain TCP Redis (local dev / self-hosted)
# REDIS_URL=redis://localhost:6379

# Optional: Gemini model override
# GEMINI_MODEL=gemini-1.5-flash
